' Общее оформление диаграмм деятельности.
' Подключайте после @startuml, перед содержимым регламента:
' !include ../components/style.puml
' Минимальный пример: examples/basic_regulation.puml.
' Палитра и оригинал логотипа: docs/ruleway_design/.

' Цвет идентификатора внутри составной подписи действия.
!$ruleway_action_id_color = "#087F74"

<style>
root {
  FontName DejaVu Sans
  FontSize 14
  FontColor #142D3B
  HyperLinkColor #087F74
  HyperLinkUnderlineThickness 1
  LineColor #087F74
  LineThickness 1.5
  BackGroundColor #FFFFFF
  Shadowing 0
}
document {
  BackGroundColor #F5F8F7
  header, title, caption, footer {
    BackGroundColor transparent
    LineColor transparent
  }
  header {
    HorizontalAlignment left
    FontColor #142D3B
    FontSize 10
  }
  title {
    FontColor #142D3B
    FontSize 22
    FontStyle bold
    Margin 16
    Padding 8
  }
  caption {
    FontColor #142D3B
    FontSize 12
  }
  footer {
    FontColor #142D3B
    FontSize 10
  }
  legend {
    FontColor #142D3B
    FontSize 12
    BackGroundColor #FFFFFF
    LineColor #087F74
    RoundCorner 12
    Padding 12
  }
}
note {
  FontName DejaVu Sans
  FontColor #142D3B
  FontSize 14
  BackGroundColor #E5F5F1
  LineColor #087F74
  LineThickness 1.5
  Padding 12
  MaximumWidth 330
  HorizontalAlignment left
}
swimlane {
  FontColor #142D3B
  FontSize 15
  FontStyle bold
  BackGroundColor #F5F8F7
  LineColor #087F74
  LineThickness 1
}
activityDiagram {
  activity {
    FontColor #142D3B
    FontSize 14
    BackGroundColor #FFFFFF
    LineColor #087F74
    LineThickness 1.5
    RoundCorner 16
    Padding 12
    HorizontalAlignment left
    MaximumWidth 330
  }
  diamond {
    FontName DejaVu Sans
    FontColor #142D3B
    FontSize 14
    HorizontalAlignment center
    BackGroundColor #E5F5F1
    LineColor #087F74
    LineThickness 1.5
  }
  arrow {
    FontColor #142D3B
    FontSize 12
    LineColor #087F74
    BackGroundColor #087F74
    LineThickness 1.5
  }
  circle {
    start, stop, end {
      LineColor #087F74
      BackGroundColor #087F74
    }
  }
  activityBar {
    LineColor #087F74
    BackGroundColor #087F74
  }
  partition, group, composite {
    FontColor #142D3B
    FontStyle bold
    BackGroundColor #E5F5F1
    LineColor #087F74
    LineThickness 1
    RoundCorner 12
  }
}
</style>

' Встроенный знак без надписи работает без сети и путей к картинкам у пользователя.
' Залитые векторные контуры сохраняют форму и приближают градиент оригинала.
' Размер 13 компенсирует масштабирование спрайта шрифтом заголовка: знак 48 × 48.
!include assets/ruleway_logo.iuml
left header
<size:13><$ruleway_logo></size>
endheader
