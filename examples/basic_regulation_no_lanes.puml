@startuml
!include ../components/action.puml

title Согласование заявки

start
repeat
$ruleway_action("РСЗ-01", "Подготовить или доработать заявку", "Инициатор", \
  "Заявка с комплектом документов и учтёнными замечаниями", \
  "Указать цель и приложить документы. При повторном проходе исправить замечания.", "До передачи на согласование")

$ruleway_action( \
  $id="РСЗ-02", \
  $name="Проверить заявку", \
  $responsible="Согласующий", \
  $result="Заключение с перечнем замечаний" + %newline() + "[[materials/review_template.html Шаблон заключения]]", \
  $instruction="1. Проверить цель заявки." + %newline() + "2. Сверить комплект документов." + %newline() + "3. Зафиксировать и передать замечания.", \
  $sla="1 рабочий день после получения", \
  $subregulation="[[review_regulation.svg Подрегламент: проверка заявки]]" \
)
repeat while (Требуется доработка?) is (да) not (нет)

$ruleway_action("РСЗ-03", "Согласовать заявку", "Согласующий", \
  "Решение о согласовании", "Зафиксировать решение и передать инициатору.", "1 рабочий день после проверки")

$ruleway_action("РСЗ-04", "Получить решение", "Инициатор", \
  "Решение получено и принято к работе", "Ознакомиться с решением.", "В день получения")
stop
@enduml
