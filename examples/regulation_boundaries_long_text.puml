@startuml
!include ../components/action.puml
!include ../components/start.puml
!include ../components/end.puml

title Проверка заявки
caption Начало и завершение · многострочные подписи

start
note right
$ruleway_start_label("Заявка с приложенными документами" + %newline() + "передана на проверку", "Сведения о цели обращения" + %newline() + "и документы, приложенные инициатором")
end note

$ruleway_action("РПЗ-01", "Проверить комплект документов", "Согласующий", \
  "Список недостающих или некорректных сведений")
$ruleway_action("РПЗ-02", "Оформить заключение", "Согласующий", \
  "Заключение с замечаниями или отметкой об их отсутствии")

stop
note right
$ruleway_end_label("Проверка заявки завершена," + %newline() + "заключение оформлено", "Перечень замечаний" + %newline() + "или отметка об их отсутствии")
end note
@enduml
