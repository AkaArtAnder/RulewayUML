@startuml
!include ../components/action.puml
!include ../components/condition.puml
!include ../components/start.puml
!include ../components/end.puml

title Условие: подробный критерий
caption Учебный пример · вопрос и основание в несколько строк

start
note right
$ruleway_start_label("Требуется подготовить комплект документов", "Исходные материалы и перечень обязательных документов")
end note

repeat
  $ruleway_action("РПД-01", "Подготовить или дополнить комплект", "Автор", \
    "Комплект документов с учётом замечаний")
  $ruleway_action("РПД-02", "Сверить комплект документов", "Проверяющий", \
    "Чек-лист с отметкой по каждому обязательному документу", \
    "Указать отсутствующие и просроченные документы. Передать замечания автору.")
repeat while ($ruleway_condition("Есть отсутствующие документы" + %newline() + "или документы с истёкшим сроком действия?", "РПД-02: чек-лист комплекта" + %newline() + "Перечень документов из правил регламента")) is (да) not (нет)

$ruleway_action("РПД-03", "Передать комплект на рассмотрение", "Проверяющий", \
  "Полный комплект передан для дальнейшей проверки")
stop
note right
$ruleway_end_label("Комплект передан на рассмотрение")
end note
@enduml
