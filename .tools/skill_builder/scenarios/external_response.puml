@startuml
!include ../../../components/action.puml
!include ../../../components/condition.puml
!include ../../../components/start.puml
!include ../../../components/end.puml

title Ожидание внешнего ответа
caption Учебный образец · контрольный срок задан до запуска

start
note right
$ruleway_start_label("Потребовалось запросить сведения", "Вопрос, адресат и установленный контрольный срок")
end note

$ruleway_action("РОТ-01", "Отправить запрос", "Координатор", \
  "Запрос отправлен; время отправки зафиксировано", \
  "Передать вопрос адресату и указать установленный контрольный срок.")

$ruleway_action("РОТ-02", "Дождаться ответа или контрольного срока", "Координатор", \
  "Зафиксировано наличие ответа; при получении указано время", \
  "Проверять поступление ответа до его получения или наступления контрольного срока. Ответ в момент срока считать своевременным.", \
  "До получения ответа, но не позднее контрольного срока")

if ($ruleway_condition("Ответ получен к контрольному сроку?", "РОТ-02: наличие ответа и время получения")) then (да)
  $ruleway_action("РОТ-03", "Передать ответ инициатору", "Координатор", \
    "Инициатор получил ответ")
  stop
  note right
  $ruleway_end_label("Ответ передан", "Инициатор получил ответ")
  end note
else (нет)
  $ruleway_action("РОТ-04", "Уведомить об отсутствии ответа", "Координатор", \
    "Инициатор уведомлён: к контрольному сроку ответа нет")
  stop
  note right
  $ruleway_end_label("Обработка запроса завершена без ответа", "Инициатор получил уведомление")
  end note
endif
@enduml
