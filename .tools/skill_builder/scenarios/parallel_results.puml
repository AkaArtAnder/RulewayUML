@startuml
!include ../../../components/action.puml
!include ../../../components/start.puml
!include ../../../components/end.puml

title Параллельная подготовка выпуска
caption Учебный образец · продолжение после обеих ветвей

start
note right
$ruleway_start_label("Поступило согласованное задание на выпуск", "Черновик текста и требования к обложке")
end note

' По учебному правилу текст и обложка готовятся независимо.
fork
  $ruleway_action( \
    $id = "РПВ-01", \
    $name = "Подготовить редакцию текста", \
    $responsible = "Редактор", \
    $result = "Текст подготовлен для выпуска", \
    $instruction = "1. Сверить содержание с заданием." + %newline() + "2. Отредактировать текст и передать координатору.", \
    $sla = "1 рабочий день после получения задания", \
    $subregulation = "[[https://example.org/regulations/text_preparation Подрегламент: подготовка текста]]" \
  )
fork again
  $ruleway_action("РПВ-02", "Подготовить обложку", "Дизайнер", \
    "Обложка подготовлена для выпуска", \
    "Подготовить обложку по согласованным требованиям.", \
    "2 рабочих дня после получения задания")
end fork

$ruleway_action("РПВ-03", "Собрать комплект выпуска", "Координатор", \
  "Комплект содержит подготовленные текст и обложку", \
  "Начать сборку после получения обоих результатов.")

stop
note right
$ruleway_end_label("Комплект выпуска подготовлен", "Текст и обложка собраны в один комплект")
end note
@enduml
