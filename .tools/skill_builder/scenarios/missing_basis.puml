@startuml
!include ../../../components/action.puml
!include ../../../components/condition.puml
!include ../../../components/start.puml
!include ../../../components/end.puml

title Отсутствующее основание решения
caption Учебный образец · отсутствие заключения не означает отказ

start
note right
$ruleway_start_label("Заявка передана для принятия решения", "Заявка; заключение при наличии")
end note

$ruleway_action("РДО-01", "Проверить наличие заключения", "Координатор", \
  "Зафиксировано наличие или отсутствие заключения")

if ($ruleway_condition("Заключение доступно?", "РДО-01: результат проверки наличия")) then (да)
  $ruleway_action("РДО-02", "Передать заключение согласующему", "Координатор", \
    "Заключение доступно согласующему")
else (нет)
  ' Новый шаг сохраняет свободный ID, а не номер позиции в маршруте.
  $ruleway_action("РДО-05", "Получить недостающее заключение", "Координатор", \
    "Заключение получено и доступно согласующему", \
    "Запросить заключение у инициатора. Продолжить после его получения и передачи согласующему.")
endif

$ruleway_action("РДО-03", "Изучить заключение и принять решение", "Согласующий", \
  "Решение о согласовании или отказе с указанием основания", \
  "Принять решение по правилам регламента на основании полученного заключения.")

if ($ruleway_condition("Заявка согласована?", "РДО-03: решение по заявке")) then (да)
  $ruleway_action("РДО-04", "Сообщить о согласовании", "Согласующий", \
    "Инициатор получил подтверждение согласования")
  stop
  note right
  $ruleway_end_label("Заявка согласована", "Инициатор получил подтверждение")
  end note
else (нет)
  $ruleway_action("РДО-06", "Сообщить об отказе", "Согласующий", \
    "Инициатор получил отказ с указанием причины")
  stop
  note right
  $ruleway_end_label("В согласовании отказано", "Инициатор получил причину отказа")
  end note
endif
@enduml
