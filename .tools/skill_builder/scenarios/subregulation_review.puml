@startuml
!include ../../../components/action.puml
!include ../../../components/condition.puml
!include ../../../components/start.puml
!include ../../../components/end.puml

title Дочерняя проверка материалов
caption Учебный образец · [[subregulation_result.svg Вернуться к основному регламенту]]

start
note right
$ruleway_start_label("Материалы поступили на проверку", "Комплект материалов и критерии проверки")
end note

$ruleway_action("РДП-01", "Оценить возможность проверки", "Проверяющий", \
  "Возможность проверки; при невозможности указана причина", \
  "Проверить доступ к материалам и наличие критериев проверки.")

if ($ruleway_condition("Проверку можно выполнить?", "РДП-01: оценка возможности проверки")) then (да)
  $ruleway_action("РДП-02", "Проверить материалы", "Проверяющий", \
    "Заключение: замечания или отметка об их отсутствии", \
    "Проверить материалы по полученным критериям. Отсутствие замечаний указать явно.", \
    "В пределах общего срока проверки: 1 рабочий день после получения материалов проверяющим")
  $ruleway_action("РДП-03", "Передать результат проверки", "Проверяющий", \
    "Координатор получил статус «выполнена» и заключение")
  stop
  note right
  $ruleway_end_label("Дочерняя проверка выполнена", "Переданы статус «выполнена» и заключение")
  end note
else (нет)
  $ruleway_action("РДП-04", "Передать причину невозможности проверки", "Проверяющий", \
    "Координатор получил статус «не выполнена» и причину")
  stop
  note right
  $ruleway_end_label("Дочерняя проверка не выполнена", "Переданы статус «не выполнена» и причина")
  end note
endif
@enduml
