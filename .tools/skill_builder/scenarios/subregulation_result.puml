@startuml
!include ../../../components/action.puml
!include ../../../components/condition.puml
!include ../../../components/start.puml
!include ../../../components/end.puml

title Проверка материалов: основной регламент
caption Учебный образец · продолжение зависит от результата дочерней проверки

start
note right
$ruleway_start_label("Потребовалось подготовить проверенные материалы", "Исходные материалы и критерии проверки")
end note

repeat
  $ruleway_action("РПМ-01", "Подготовить или доработать материалы", "Автор", \
    "Комплект материалов готов к проверке", \
    "При повторном выполнении устранить замечания из последнего заключения.")

  $ruleway_action( \
    $id = "РПМ-02", \
    $name = "Организовать проверку и получить результат", \
    $responsible = "Координатор", \
    $result = "Статус проверки и заключение либо причина невозможности", \
    $instruction = "1. Передать комплект и критерии проверяющему." + %newline() + "2. Получить статус: выполнена или не выполнена." + %newline() + "3. Получить заключение либо причину невозможности.", \
    $sla = "1 рабочий день после получения материалов проверяющим; на каждый проход", \
    $subregulation = "[[subregulation_review.svg Дочерний регламент: проверка материалов]]" \
  )

  if ($ruleway_condition("Дочерняя проверка выполнена?", "РПМ-02: полученный статус проверки")) then (да)
    $ruleway_action("РПМ-03", "Разобрать заключение", "Координатор", \
      "Зафиксировано наличие или отсутствие замечаний")
  else (нет)
    $ruleway_action("РПМ-05", "Сообщить о невозможности проверки", "Координатор", \
      "Автор получил причину невозможности проверки")
    stop
    note right
    $ruleway_end_label("Подготовка завершена без проверки", "Автор получил причину; материалы не приняты")
    end note
  endif
repeat while ($ruleway_condition("В заключении есть замечания?", "РПМ-03: результат разбора последнего заключения")) is (да) not (нет)

$ruleway_action("РПМ-04", "Принять проверенные материалы", "Координатор", \
  "Материалы приняты по заключению без замечаний")

stop
note right
$ruleway_end_label("Проверенные материалы приняты", "Комплект материалов и заключение без замечаний")
end note
@enduml
