@startuml
!include ../../../components/action.puml
!include ../../../components/condition.puml
!include boundary_design.iuml

title Согласование заявки
caption Макет границ · дорожки и многострочное описание

|Инициатор|
start
note right
$ruleway_design_start_label("У инициатора возникла потребность" + %newline() + "в согласовании", "Сведения о цели обращения" + %newline() + "и исходные материалы")
end note

repeat
  $ruleway_action("РСЗ-01", "Подготовить или доработать заявку", "Инициатор", \
    "Заявка с комплектом документов и учтёнными замечаниями", \
    "Указать цель и приложить документы. При повторном проходе исправить замечания.")

  |Согласующий|
  $ruleway_action("РСЗ-02", "Проверить заявку", "Согласующий", \
    "Заключение: перечень замечаний или отметка об их отсутствии", \
    "Проверить цель заявки, комплект документов. Зафиксировать и передать замечания.")
repeat while ($ruleway_condition("В заключении есть замечания?", "РСЗ-02: заключение")) is (да) not (нет)

$ruleway_action("РСЗ-03", "Согласовать заявку", "Согласующий", \
  "Решение о согласовании", "Зафиксировать решение и передать инициатору.")

|Инициатор|
$ruleway_action("РСЗ-04", "Получить решение", "Инициатор", \
  "Решение получено и принято к работе")

stop
note right
$ruleway_design_end_label("Заявка согласована", "Решение получено инициатором" + %newline() + "и принято к работе")
end note
@enduml
