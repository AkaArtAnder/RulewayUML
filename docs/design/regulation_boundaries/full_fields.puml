@startuml
!include ../../../components/action.puml
!include boundary_design.iuml

title Проверка заявки
caption Макет начала и завершения · полное заполнение

start
note right
$ruleway_design_start_label("Заявка передана на проверку", "Заявка и приложенные документы")
