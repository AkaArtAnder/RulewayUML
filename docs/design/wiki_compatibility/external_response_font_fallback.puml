' Действие регламента. Подключение: !include ../components/action.puml
' Описание параметров: docs/specification/components/action.md.
' Подключение задаёт оформление и определения, но не создаёт процесс.

!procedure $ruleway_action($id, $name, $responsible, $result, $instruction = "", $sla = "", $subregulation = "")
  !assert %strlen($id) == 6 : "Ruleway: идентификатор должен иметь вид РСТ-03"
  !assert %substr($id, 0, 1) == "Р" && %substr($id, 3, 1) == "-" : "Ruleway: нужны кириллическая Р, два символа аббревиатуры и дефис"
  !assert %strpos("0123456789", %substr($id, 4, 1)) >= 0 && %strpos("0123456789", %substr($id, 5, 1)) >= 0 : "Ruleway: номер действия должен состоять из двух цифр"
  !assert %strlen($name) > 0 : "Ruleway: укажите название действия"
  !assert %strlen($responsible) > 0 : "Ruleway: укажите ответственную роль"
  !assert %strlen($result) > 0 : "Ruleway: укажите ожидаемый результат"

  ' Одна строка исходника сохраняет точки с запятой внутри содержимого.
  ' %newline() переносит отображаемый текст, не создавая новые команды процесса.
  !local $ruleway_label = "<color:" + $ruleway_action_id_color + "><b>" + $id + "</b></color>  <b>" + $name + "</b>"
  !local $ruleway_label = $ruleway_label + %newline() + %newline() + "<b>Ответственный:</b> " + $responsible
  !if %strlen($sla) > 0
    !local $ruleway_label = $ruleway_label + %newline() + "<b>Срок:</b> " + $sla
  !endif
  !local $ruleway_label = $ruleway_label + %newline() + %newline() + "<b>Результат:</b> " + $result
  !if %strlen($instruction) > 0
    !local $ruleway_label = $ruleway_label + %newline() + %newline() + "<b>Инструкция / чек-лист</b>" + %newline() + $instruction
  !endif
  !if %strlen($subregulation) > 0
    !local $ruleway_label = $ruleway_label + %newline() + %newline() + $subregulation
  !endif
:$ruleway_label;
!endprocedure

' Условие регламента. Подключение: !include ../components/condition.puml
' Описание параметров: docs/specification/components/condition.md.
' Возвращает подпись для стандартных if и repeat while; не создаёт переходы.

!function $ruleway_condition($question, $basis)
  !assert %strlen($question) > 0 : "Ruleway: укажите вопрос условия"
  !assert %strlen($basis) > 0 : "Ruleway: укажите основание для ответа"
  ' Жирное начертание применяется построчно; выравнивание задаёт общий стиль.
  ' Пустые строки сверху и снизу задают внутренние отступы только этого условия.
  !local $ruleway_label = %newline()
  !foreach $ruleway_line in %splitstr($question, %newline())
    !local $ruleway_label = $ruleway_label + "<b>" + $ruleway_line + "</b>" + %newline()
  !endfor
  !local $ruleway_separator = %newline()
  !foreach $ruleway_line in %splitstr("<b>Основание:</b> " + $basis, %newline())
    !local $ruleway_label = $ruleway_label + $ruleway_separator + $ruleway_line
    !local $ruleway_separator = %newline()
  !endfor
  !return $ruleway_label + %newline()
!endfunction

' Внутренняя сборка подписей начала и завершения; не публичный API.
!function $ruleway_boundary_label($title, $details, $details_label)
  !local $ruleway_label = ""
  !local $ruleway_separator = ""
  ' Каждая строка заголовка сохраняет жирное начертание.
  !foreach $ruleway_line in %splitstr($title, %newline())
    !local $ruleway_label = $ruleway_label + $ruleway_separator + "<b>" + $ruleway_line + "</b>"
    !local $ruleway_separator = %newline()
  !endfor
  !if %strlen($details) > 0
    !local $ruleway_label = $ruleway_label + %newline() + %newline() + "<b>" + $details_label + ":</b> " + $details
  !endif
  !return $ruleway_label
!endfunction

' Начало регламента. Подключение: !include ../components/start.puml
' Описание параметров: docs/specification/components/start.md.
' Возвращает подпись для note right после стандартного start.

!function $ruleway_start_label($event, $inputs = "")
  !assert %strlen($event) > 0 : "Ruleway: укажите событие начала"
  !return $ruleway_boundary_label($event, $inputs, "Входы")
!endfunction

' Завершение регламента. Подключение: !include ../components/end.puml
' Описание параметров: docs/specification/components/end.md.
' Возвращает подпись для note right после стандартного stop.

!function $ruleway_end_label($outcome, $result = "")
  !assert %strlen($outcome) > 0 : "Ruleway: укажите исход завершения"
  !return $ruleway_boundary_label($outcome, $result, "Результат")
!endfunction


title Ожидание внешнего ответа
caption Учебный образец · контрольный срок задан до запуска

start
note right
$ruleway_start_label("Потребовалось запросить сведения", "Вопрос, адресат и установленный контрольный срок")
end note

$ruleway_action("РОТ-01", "Отправить запрос", "Координатор", \
  "Запрос отправлен; время отправки зафиксировано", \
  "Передать вопрос адресату и указать установленный контрольный срок.")

$ruleway_action("РОТ-02", "Дождаться ответа или контрольного срока", "Координатор", \
  "Зафиксировано наличие ответа; при получении указано время", \
  "Проверять поступление ответа до его получения или наступления контрольного срока. Ответ в момент срока считать своевременным.", \
  "До получения ответа, но не позднее контрольного срока")

if ($ruleway_condition("Ответ получен к контрольному сроку?", "РОТ-02: наличие ответа и время получения")) then (да)
  $ruleway_action("РОТ-03", "Передать ответ инициатору", "Координатор", \
    "Инициатор получил ответ")
  stop
  note right
  $ruleway_end_label("Ответ передан", "Инициатор получил ответ")
  end note
else (нет)
  $ruleway_action("РОТ-04", "Уведомить об отсутствии ответа", "Координатор", \
    "Инициатор уведомлён: к контрольному сроку ответа нет")
  stop
  note right
  $ruleway_end_label("Обработка запроса завершена без ответа", "Инициатор получил уведомление")
  end note
endif
@enduml
